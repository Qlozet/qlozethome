# Qlozet AI Recommendation Engine: Flutter & Dart Frontend API Integration Guideline

Welcome to the **Qlozet AI Recommendation & Style Matching System** integration guide for Flutter. This document contains everything your mobile team needs to connect, parse, render, and track recommendations using clean Dart architectural patterns.

---

## 🗺️ System Overview & Architecture

The recommendation engine runs an advanced pipeline involving Retrieval, Filtering, and Ranking on the backend. 

*   **Network Client recommendation**: We recommend using the **`dio`** package rather than the basic `http` package because `dio` supports simple global interceptors (for JWT auth), custom timeouts, and unified logging.
*   **JSON Serialization**: The Dart models below contain `fromJson` constructors. You can use packages like `json_serializable` if your project prefers automated code generation.

---

## 🔐 Authentication & Headers

Attach the JWT Access Token dynamically in your network client.

*   **Base URL**: `https://api.qlozet.com/v1` (or your staging/local endpoint)
*   **Headers**:
    ```http
    Authorization: Bearer <JWT_ACCESS_TOKEN>
    Content-Type: application/json
    ```

---

## 📦 Dart Models (Type-Safe Objects)

Create these classes in your `/lib/models` directory. They support nested JSON parsing for seamless integration.

```dart
import 'dart:convert';

enum ReasonCode {
  STYLE_MATCH,
  AESTHETIC_MATCH,
  TRUSTED_VENDOR,
  FAST_ETA,
  PRICE_FIT,
  FIT_COMPATIBLE,
  TRENDING
}

extension ReasonCodeExtension on ReasonCode {
  String get name {
    return toString().split('.').last;
  }
}

ReasonCode reasonCodeFromString(String code) {
  return ReasonCode.values.firstWhere(
    (e) => e.name == code,
    orElse: () => ReasonCode.STYLE_MATCH,
  );
}

enum CatalogItemType { garment, fabric, accessory, template }

CatalogItemType catalogItemTypeFromString(String type) {
  return CatalogItemType.values.firstWhere(
    (e) => e.toString().split('.').last == type,
    orElse: () => CatalogItemType.garment,
  );
}

class FitMeta {
  final String targetDemographic;
  final String fitType;
  final List<String> measurementsPoints;

  FitMeta({
    required this.targetDemographic,
    required this.fitType,
    required this.measurementsPoints,
  });

  factory FitMeta.fromJson(Map<String, dynamic> json) {
    return FitMeta(
      targetDemographic: json['targetDemographic'] ?? 'unisex',
      fitType: json['fitType'] ?? 'regular',
      measurementsPoints: List<String>.from(json['measurementsPoints'] ?? []),
    );
  }
}

class CatalogItem {
  final String itemId;
  final CatalogItemType type;
  final String name;
  final String description;
  final List<String> tags;
  final double price;
  final String currency;
  final String vendor;
  final String? vendorUrl;
  final FitMeta? fitMeta;
  final String? fabricComposition;
  final String? material;
  final String? templateUrl;
  final Map<String, dynamic>? rawVendorData; // Contains original full Product details (images, sizing, etc.)

  CatalogItem({
    required this.itemId,
    required this.type,
    required this.name,
    required this.description,
    required this.tags,
    required this.price,
    required this.currency,
    required this.vendor,
    this.vendorUrl,
    this.fitMeta,
    this.fabricComposition,
    this.material,
    this.templateUrl,
    this.rawVendorData,
  });

  factory CatalogItem.fromJson(Map<String, dynamic> json) {
    return CatalogItem(
      itemId: json['itemId'] as String,
      type: catalogItemTypeFromString(json['type'] ?? ''),
      name: json['name'] ?? 'Product Item',
      description: json['description'] ?? '',
      tags: List<String>.from(json['tags'] ?? []),
      price: (json['price'] as num?)?.toDouble() ?? 0.0,
      currency: json['currency'] ?? 'NGN',
      vendor: json['vendor'] ?? 'Unknown',
      vendorUrl: json['vendorUrl'],
      fitMeta: json['fitMeta'] != null ? FitMeta.fromJson(json['fitMeta']) : null,
      fabricComposition: json['fabricComposition'],
      material: json['material'],
      templateUrl: json['templateUrl'],
      rawVendorData: json['rawVendorData'] is Map ? json['rawVendorData'] : null,
    );
  }
}

class FeedItem extends CatalogItem {
  final int position;
  final String stream;
  final List<ReasonCode> reasonCodes;
  final List<String> explanations;

  FeedItem({
    required String itemId,
    required CatalogItemType type,
    required String name,
    required String description,
    required List<String> tags,
    required double price,
    required String currency,
    required String vendor,
    String? vendorUrl,
    FitMeta? fitMeta,
    String? fabricComposition,
    String? material,
    String? templateUrl,
    Map<String, dynamic>? rawVendorData,
    required this.position,
    required this.stream,
    required this.reasonCodes,
    required this.explanations,
  }) : super(
          itemId: itemId,
          type: type,
          name: name,
          description: description,
          tags: tags,
          price: price,
          currency: currency,
          vendor: vendor,
          vendorUrl: vendorUrl,
          fitMeta: fitMeta,
          fabricComposition: fabricComposition,
          material: material,
          templateUrl: templateUrl,
          rawVendorData: rawVendorData,
        );

  factory FeedItem.fromJson(Map<String, dynamic> json) {
    final baseItem = CatalogItem.fromJson(json);
    return FeedItem(
      itemId: baseItem.itemId,
      type: baseItem.type,
      name: baseItem.name,
      description: baseItem.description,
      tags: baseItem.tags,
      price: baseItem.price,
      currency: baseItem.currency,
      vendor: baseItem.vendor,
      vendorUrl: baseItem.vendorUrl,
      fitMeta: baseItem.fitMeta,
      fabricComposition: baseItem.fabricComposition,
      material: baseItem.material,
      templateUrl: baseItem.templateUrl,
      rawVendorData: baseItem.rawVendorData,
      position: json['position'] ?? 0,
      stream: json['stream'] ?? '',
      reasonCodes: (json['reasonCodes'] as List? ?? [])
          .map((c) => reasonCodeFromString(c.toString()))
          .toList(),
      explanations: List<String>.from(json['explanations'] ?? []),
    );
  }
}

class FeedResponse {
  final List<FeedItem> items;
  final Map<String, dynamic>? debug;

  FeedResponse({required this.items, this.debug});

  factory FeedResponse.fromJson(Map<String, dynamic> json) {
    return FeedResponse(
      items: (json['items'] as List? ?? [])
          .map((item) => FeedItem.fromJson(item))
          .toList(),
      debug: json['debug'] is Map ? json['debug'] : null,
    );
  }
}

class VendorFeedItem {
  final String vendorId;
  final String vendorName;
  final double vendorScore;
  final List<String> reasonCodes;
  final List<String> explanations;
  final List<FeedItem> products;
  final int totalProducts;
  final double? successRate;
  final bool? isFeatured;
  final int? averageDeliveryDays;

  VendorFeedItem({
    required this.vendorId,
    required this.vendorName,
    required this.vendorScore,
    required this.reasonCodes,
    required this.explanations,
    required this.products,
    required this.totalProducts,
    this.successRate,
    this.isFeatured,
    this.averageDeliveryDays,
  });

  factory VendorFeedItem.fromJson(Map<String, dynamic> json) {
    return VendorFeedItem(
      vendorId: json['vendorId'] ?? '',
      vendorName: json['vendorName'] ?? 'Unknown Vendor',
      vendorScore: (json['vendorScore'] as num?)?.toDouble() ?? 0.0,
      reasonCodes: List<String>.from(json['reasonCodes'] ?? []),
      explanations: List<String>.from(json['explanations'] ?? []),
      products: (json['products'] as List? ?? [])
          .map((p) => FeedItem.fromJson(p))
          .toList(),
      totalProducts: json['totalProducts'] ?? 0,
      successRate: (json['successRate'] as num?)?.toDouble(),
      isFeatured: json['isFeatured'] as bool?,
      averageDeliveryDays: json['averageDeliveryDays'] as int?,
    );
  }
}

class VendorFeedResponse {
  final String requestId;
  final List<VendorFeedItem> vendors;

  VendorFeedResponse({required this.requestId, required this.vendors});

  factory VendorFeedResponse.fromJson(Map<String, dynamic> json) {
    return VendorFeedResponse(
      requestId: json['requestId'] ?? '',
      vendors: (json['vendors'] as List? ?? [])
          .map((v) => VendorFeedItem.fromJson(v))
          .toList(),
    );
  }
}
```

