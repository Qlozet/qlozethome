## 📡 Endpoint Mapping (HTTP Routes)

Implement these methods in your API data layer.

### 1. Personalized Home Discovery (`GET /recommends/feed`)
*   **Path**: `/recommends/feed`
*   **Params**: `userId` (required), `sessionId` (optional), `limit` (optional), `budgetMax` (optional), `deadlineDays` (optional).
*   **Use-case**: Dynamic custom homepage feed. Apply budget limits instantly.

### 2. Recommended Boutiques (`GET /recommends/vendors`)
*   **Path**: `/recommends/vendors`
*   **Params**: `userId` (required), `limit` (optional), `productsPerVendor` (optional).
*   **Use-case**: Display a horizontal Boutique Strip on the dashboard with preview items inside.

### 3. Trending & Hot Items (`GET /recommends/trending`)
*   **Path**: `/recommends/trending` (Public - no token needed)
*   **Params**: `limit` (optional).

### 4. New Drops (`GET /recommends/new`)
*   **Path**: `/recommends/new` (Public)
*   **Params**: `limit`, `days` (lookback threshold).

### 5. Frequently Bought Together (`GET /recommends/bought-together`)
*   **Path**: `/recommends/bought-together`
*   **Params**: `itemId` (required), `limit` (optional).
*   **Use-case**: PDP matching accessories or fabrics.

### 6. Outfit Maker - Complete the Look (`GET /recommends/complete-look`)
*   **Path**: `/recommends/complete-look`
*   **Params**: `itemIds` (comma-separated string, e.g. `"id1,id2"`), `userId` (optional), `limit`.

---

## ⚡ Unified Dio API Client (Dart)

This client manages persistent session tokens, local storage access headers, response parsing, and gracefully handles network exceptions.

```dart
import 'dart:math';
import 'package:dio/dio.dart';
import 'package:shared_preferences/shared_preferences.dart';
import '../models/recommendation.models.dart';

class RecommendationApiClient {
  final Dio _dio;
  late String _sessionId;

  RecommendationApiClient({Dio? dioClient})
      : _dio = dioClient ?? Dio(BaseOptions(
          baseUrl: 'https://api.qlozet.com/v1',
          connectTimeout: const Duration(seconds: 8),
          receiveTimeout: const Duration(seconds: 8),
        )) {
    _initSession();
    _setupInterceptors();
  }

  void _initSession() {
    // Generate a random stable alphanumeric session string
    final random = Random();
    const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';
    _sessionId = List.generate(16, (index) => chars[random.nextInt(chars.length)]).join();
  }

  void _setupInterceptors() {
    _dio.interceptors.add(
      InterceptorsWrapper(
        onRequest: (options, handler) async {
          final prefs = await SharedPreferences.getInstance();
          final token = prefs.getString('qlozet_access_token');
          if (token != null) {
            options.headers['Authorization'] = 'Bearer $token';
          }
          options.headers['Content-Type'] = 'application/json';
          return handler.next(options);
        },
        onError: (DioException e, handler) {
          // Add telemetry logging or analytics error captures here
          print('Recommendation API Error: ${e.message}');
          return handler.next(e);
        },
      ),
    );
  }

  /// 1. Fetch Personalized Discovery Feed
  Future<FeedResponse> getHomeFeed({
    required String userId,
    int limit = 30,
    double? budgetMax,
    int? deadlineDays,
  }) async {
    try {
      final response = await _dio.get('/recommends/feed', queryParameters: {
        'userId': userId,
        'sessionId': _sessionId,
        'limit': limit,
        if (budgetMax != null) 'budgetMax': budgetMax.toInt(),
        if (deadlineDays != null) 'deadlineDays': deadlineDays,
      });

      return FeedResponse.fromJson(response.data);
    } on DioException catch (e) {
      // Graceful fallback to trending feed on exception
      print('Falling back to trending feed due to error: ${e.message}');
      return getTrendingFeed(limit: limit);
    }
  }

  /// 2. Fetch Curated Boutiques
  Future<VendorFeedResponse> getRecommendedVendors({
    required String userId,
    int limit = 10,
    int productsPerVendor = 3,
  }) async {
    final response = await _dio.get('/recommends/vendors', queryParameters: {
      'userId': userId,
      'limit': limit,
      'productsPerVendor': productsPerVendor,
    });
    return VendorFeedResponse.fromJson(response.data);
  }

  /// 3. Fetch Trending Items (Public)
  Future<FeedResponse> getTrendingFeed({int limit = 30}) async {
    final response = await _dio.get('/recommends/trending', queryParameters: {
      'limit': limit,
    });
    return FeedResponse.fromJson(response.data);
  }

  /// 4. Fetch Frequently Bought Together (PDP Add-on)
  Future<List<FeedItem>> getFrequentlyBoughtTogether({
    required String itemId,
    int limit = 4,
  }) async {
    final response = await _dio.get('/recommends/bought-together', queryParameters: {
      'itemId': itemId,
      'limit': limit,
    });
    final list = response.data['items'] as List? ?? [];
    return list.map((item) => FeedItem.fromJson(item)).toList();
  }

  /// 5. Complete the Look (Outfit suggestions)
  Future<List<FeedItem>> getCompleteTheLook({
    required List<String> itemIds,
    String? userId,
    int limit = 6,
  }) async {
    final response = await _dio.get('/recommends/complete-look', queryParameters: {
      'itemIds': itemIds.join(','),
      if (userId != null) 'userId': userId,
      'limit': limit,
    });
    final list = response.data['items'] as List? ?? [];
    return list.map((item) => FeedItem.fromJson(item)).toList();
  }

  /// 6. Track Dynamic Interaction Events (Crucial for AI model refinement)
  Future<void> trackEvent({
    required String userId,
    required String eventType,
    Map<String, dynamic>? properties,
    String? surface,
    String? requestId,
    int? position,
    String? stream,
    List<String>? reasonCodes,
    int? dwellMs,
  }) async {
    try {
      await _dio.post('/recommendations/events', data: {
        'userId': userId,
        'eventType': eventType,
        'timestamp': DateTime.now().toUtc().toIso8601String(),
        if (properties != null) 'properties': properties,
        'context': {
          if (surface != null) 'surface': surface,
          if (requestId != null) 'requestId': requestId,
          if (position != null) 'position': position,
          if (stream != null) 'stream': stream,
        },
        'metadata': {
          if (reasonCodes != null) 'reasonCodes': reasonCodes,
          if (dwellMs != null) 'dwellMs': dwellMs,
        }
      });
    } catch (e) {
      // Analytics failures should never crash or freeze the UI thread
      print('Failed to ingest telemetry event: $e');
    }
  }
}
```

